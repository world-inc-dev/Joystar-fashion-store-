    /* ================= TOAST ================= */

    .toast {
      position: fixed;
      bottom: 90px;
      left: 50%;
      transform: translate(-50%, 20px);
      background: var(--black);
      color: #fff;
      padding: 13px 20px;
      border-radius: 8px;
      z-index: 2000;
      opacity: 0;
      visibility: hidden;
      transition: .3s;
      font-size: 13px;
      text-align: center;
    }

    .toast.show {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
    }

