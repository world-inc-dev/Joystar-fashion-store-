<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Joystar Fashion Store — Discover premium fashion, elegant styles and new arrivals in Kampala, Uganda.">
  <meta name="theme-color" content="#111111">
  <title>Joystar Fashion Store | Kampala</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --black: #111111;
      --dark: #181818;
      --gold: #c9a227;
      --gold-light: #e5c65a;
      --cream: #f8f5ef;
      --white: #ffffff;
      --gray: #777;
      --light-gray: #eeeeee;
      --green: #25d366;
      --danger: #d83b3b;
      --shadow: 0 15px 45px rgba(0,0,0,.10);
      --radius: 18px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: "DM Sans", sans-serif;
      color: var(--black);
      background: var(--white);
      line-height: 1.6;
      overflow-x: hidden;
    }

    img {
      width: 100%;
      display: block;
      object-fit: cover;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select {
      font: inherit;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    /* ================= HEADER ================= */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255,255,255,.96);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid #eee;
    }

    .navbar {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: "Playfair Display", serif;
      font-size: 24px;
      font-weight: 700;
      white-space: nowrap;
    }

    .logo-mark {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--black);
      color: var(--gold-light);
      display: grid;
      place-items: center;
      font-family: "Playfair Display", serif;
      font-size: 20px;
      border: 2px solid var(--gold);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      font-size: 14px;
      font-weight: 600;
      transition: .25s;
    }

    .nav-links a:hover {
      color: var(--gold);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .icon-btn {
      border: 0;
      background: transparent;
      cursor: pointer;
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      font-size: 20px;
      position: relative;
      border-radius: 50%;
      transition: .25s;
    }

    .icon-btn:hover {
      background: var(--cream);
    }

    .cart-count {
      position: absolute;
      top: 2px;
      right: 1px;
      background: var(--gold);
      color: #fff;
      width: 19px;
      height: 19px;
      font-size: 11px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      font-weight: 700;
    }

    .menu-btn {
      display: none;
    }

    /* ================= HERO ================= */

    .hero {
      min-height: 680px;
      background:
        linear-gradient(90deg, rgba(0,0,0,.78), rgba(0,0,0,.32)),
        url("https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=1800&q=85")
        center/cover;
      color: #fff;
      display: flex;
      align-items: center;
    }

    .hero-content {
      max-width: 650px;
      padding: 90px 0;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 12px;
      font-weight: 700;
      color: var(--gold-light);
      margin-bottom: 18px;
    }

    .eyebrow::before {
      content: "";
      width: 35px;
      height: 1px;
      background: var(--gold-light);
    }

    .hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(48px, 7vw, 82px);
      line-height: 1.02;
      margin-bottom: 22px;
    }

    .hero p {
      color: #eee;
      font-size: 17px;
      max-width: 570px;
      margin-bottom: 34px;
    }

    .hero-buttons {
      display: flex;
      gap: 13px;
      flex-wrap: wrap;
    }

    .btn {
      border: 0;
      padding: 14px 25px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 700;
      transition: .25s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-gold {
      background: var(--gold);
      color: #fff;
    }

    .btn-gold:hover {
      background: var(--gold-light);
      transform: translateY(-2px);
    }

    .btn-white {
      background: #fff;
      color: #111;
    }

    .btn-white:hover {
      transform: translateY(-2px);
    }

    /* ================= ANNOUNCEMENT ================= */

    .announcement {
      background: var(--black);
      color: #fff;
      overflow: hidden;
    }

    .announcement-inner {
      min-height: 44px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 35px;
      font-size: 13px;
      font-weight: 600;
      flex-wrap: wrap;
    }

    .announcement span {
      color: var(--gold-light);
    }

    /* ================= SECTION ================= */

    section {
      padding: 90px 0;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-heading .small {
      color: var(--gold);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 800;
    }

    .section-heading h2 {
      font-family: "Playfair Display", serif;
      font-size: clamp(34px, 5vw, 48px);
      margin: 8px 0;
    }

    .section-heading p {
      max-width: 620px;
      margin: auto;
      color: var(--gray);
    }

    /* ================= CATEGORIES ================= */

    .category-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .category-card {
      height: 330px;
      position: relative;
      overflow: hidden;
      border-radius: var(--radius);
      cursor: pointer;
    }

    .category-card img {
      height: 100%;
      transition: transform .5s;
    }

    .category-card:hover img {
      transform: scale(1.07);
    }

    .category-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(transparent 40%, rgba(0,0,0,.78));
      display: flex;
      align-items: flex-end;
      padding: 25px;
      color: #fff;
    }

    .category-overlay h3 {
      font-family: "Playfair Display", serif;
      font-size: 26px;
    }

    .category-overlay span {
      font-size: 12px;
      color: #ddd;
    }

    /* ================= SHOP ================= */

    .shop-section {
      background: var(--cream);
    }

    .shop-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 30px;
      flex-wrap: wrap;
    }

    .search-box {
      flex: 1;
      min-width: 240px;
      position: relative;
    }

    .search-box input {
      width: 100%;
      border: 1px solid #ddd;
      background: #fff;
      border-radius: 8px;
      padding: 14px 18px 14px 45px;
      outline: none;
    }

    .search-box span {
      position: absolute;
      left: 16px;
      top: 11px;
      font-size: 20px;
    }

    .filter-buttons {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
    }

    .filter-btn {
      background: #fff;
      border: 1px solid #ddd;
      padding: 10px 15px;
      border-radius: 7px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
    }

    .filter-btn.active,
    .filter-btn:hover {
      background: var(--black);
      color: #fff;
      border-color: var(--black);
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .product-card {
      background: #fff;
      border-radius: 15px;
      overflow: hidden;
      position: relative;
      transition: .3s;
    }

    .product-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow);
    }

    .product-image {
      height: 310px;
      position: relative;
      overflow: hidden;
      background: #eee;
    }

    .product-image img {
      height: 100%;
      transition: transform .5s;
    }

    .product-card:hover .product-image img {
      transform: scale(1.05);
    }

    .badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--black);
      color: #fff;
      padding: 5px 9px;
      font-size: 10px;
      text-transform: uppercase;
      font-weight: 700;
      border-radius: 4px;
      z-index: 2;
    }

    .badge.sale {
      background: var(--danger);
    }

    .wishlist {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 3;
      background: #fff;
      border: 0;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 18px;
    }

    .wishlist.active {
      color: #d33;
    }

    .product-info {
      padding: 17px;
    }

    .product-category {
      color: var(--gray);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 10px;
      font-weight: 700;
    }

    .product-info h3 {
      font-size: 16px;
      margin: 3px 0 7px;
    }

    .stars {
      color: var(--gold);
      font-size: 12px;
      margin-bottom: 7px;
    }

    .price {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 800;
    }

    .old-price {
      text-decoration: line-through;
      color: #aaa;
      font-size: 13px;
      font-weight: 500;
    }

    .stock {
      margin-top: 7px;
      font-size: 11px;
      color: #16803c;
      font-weight: 700;
    }

    .stock.low {
      color: #c06b00;
    }

    .product-bottom {
      margin-top: 13px;
      display: flex;
      gap: 7px;
    }

    .add-cart {
      flex: 1;
      border: 1px solid var(--black);
      background: var(--black);
      color: #fff;
      padding: 10px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
    }

    .add-cart:hover {
      background: var(--gold);
      border-color: var(--gold);
    }

    .quick-view {
      width: 42px;
      border: 1px solid #ddd;
      background: #fff;
      border-radius: 6px;
      cursor: pointer;
    }

    /* ================= PROMO ================= */

    .promo {
      padding: 0;
    }

    .promo-box {
      min-height: 390px;
      background:
        linear-gradient(90deg, rgba(0,0,0,.75), rgba(0,0,0,.20)),
        url("https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1600&q=85")
        center/cover;
      border-radius: 22px;
      display: flex;
      align-items: center;
      padding: 60px;
      color: #fff;
    }

    .promo-content {
      max-width: 500px;
    }

    .promo-content h2 {
      font-family: "Playfair Display", serif;
      font-size: clamp(35px, 5vw, 56px);
      line-height: 1.05;
      margin: 12px 0 18px;
    }

    .promo-content p {
      color: #eee;
      margin-bottom: 25px;
    }

    /* ================= WHY US ================= */

    .features {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .feature {
      padding: 28px 20px;
      border: 1px solid #eee;
      border-radius: 14px;
      text-align: center;
    }

    .feature-icon {
      font-size: 30px;
      margin-bottom: 10px;
    }

    .feature h3 {
      font-size: 16px;
      margin-bottom: 5px;
    }

    .feature p {
      color: var(--gray);
      font-size: 13px;
    }

    /* ================= TESTIMONIALS ================= */

    .testimonials {
      background: var(--black);
      color: #fff;
    }

    .testimonials .section-heading p {
      color: #aaa;
    }

    .testimonial-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .testimonial {
      background: #1d1d1d;
      padding: 30px;
      border: 1px solid #2e2e2e;
      border-radius: 16px;
    }

    .testimonial .stars {
      margin-bottom: 16px;
    }

    .testimonial p {
      color: #ddd;
      font-size: 14px;
      margin-bottom: 20px;
    }

    .customer {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .customer-avatar {
      width: 43px;
      height: 43px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--gold);
      color: #fff;
      font-weight: 800;
    }

    .customer strong {
      display: block;
      font-size: 14px;
    }

    .customer span {
      color: #999;
      font-size: 11px;
    }

    /* ================= ABOUT ================= */

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-image {
      height: 530px;
      border-radius: 20px;
      overflow: hidden;
    }

    .about-image img {
      height: 100%;
    }

    .about-content .small {
      color: var(--gold);
      font-size: 12px;
      letter-spacing: 2px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .about-content h2 {
      font-family: "Playfair Display", serif;
      font-size: clamp(38px, 5vw, 55px);
      line-height: 1.05;
      margin: 10px 0 20px;
    }

    .about-content p {
      color: var(--gray);
      margin-bottom: 18px;
    }

    .about-list {
      list-style: none;
      margin: 25px 0;
    }

    .about-list li {
      margin: 10px 0;
      font-weight: 600;
      font-size: 14px;
    }

    .about-list li::before {
      content: "✓";
      color: var(--gold);
      margin-right: 10px;
      font-weight: 900;
    }

    /* ================= CONTACT ================= */

    .contact-section {
      background: var(--cream);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .contact-card {
      background: #fff;
      border-radius: 18px;
      padding: 35px;
    }

    .contact-card h3 {
      font-family: "Playfair Display", serif;
      font-size: 28px;
      margin-bottom: 20px;
    }

    .contact-item {
      display: flex;
      gap: 14px;
      margin: 18px 0;
    }

    .contact-icon {
      width: 40px;
      height: 40px;
      background: var(--cream);
      border-radius: 50%;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .contact-item strong {
      display: block;
      font-size: 13px;
    }

    .contact-item span {
      color: var(--gray);
      font-size: 13px;
    }

    .contact-form {
      display: grid;
      gap: 13px;
    }

    .contact-form input,
    .contact-form textarea {
      width: 100%;
      border: 1px solid #ddd;
      border-radius: 7px;
      padding: 14px;
      outline: none;
      resize: vertical;
    }

    .contact-form textarea {
      min-height: 120px;
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
      border-color: var(--gold);
    }

    /* ================= NEWSLETTER ================= */

    .newsletter {
      background: var(--gold);
      color: #fff;
      padding: 60px 0;
    }

    .newsletter-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
    }

    .newsletter h2 {
      font-family: "Playfair Display", serif;
      font-size: 35px;
    }

    .newsletter p {
      opacity: .9;
    }

    .newsletter-form {
      display: flex;
      min-width: 420px;
    }

    .newsletter-form input {
      flex: 1;
      border: 0;
      padding: 15px;
      outline: none;
      border-radius: 6px 0 0 6px;
    }

    .newsletter-form button {
      border: 0;
      padding: 0 22px;
      background: var(--black);
      color: #fff;
      font-weight: 700;
      border-radius: 0 6px 6px 0;
      cursor: pointer;
    }

    /* ================= FOOTER ================= */

    footer {
      background: #0d0d0d;
      color: #fff;
      padding: 65px 0 25px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 40px;
      padding-bottom: 45px;
    }

    .footer-brand p {
      color: #999;
      font-size: 13px;
      max-width: 330px;
      margin: 18px 0;
    }

    .footer-title {
      font-weight: 700;
      margin-bottom: 15px;
    }

    .footer-links {
      list-style: none;
    }

    .footer-links li {
      margin: 9px 0;
      color: #999;
      font-size: 13px;
    }

    .footer-links a:hover {
      color: var(--gold-light);
    }

    .socials {
      display: flex;
      gap: 8px;
    }

    .socials a {
      width: 37px;
      height: 37px;
      border: 1px solid #333;
      display: grid;
      place-items: center;
      border-radius: 50%;
      font-size: 14px;
    }

    .socials a:hover {
      background: var(--gold);
      border-color: var(--gold);
    }

    .footer-bottom {
      border-top: 1px solid #292929;
      padding-top: 22px;
      color: #777;
      font-size: 12px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }

    /* ================= WHATSAPP ================= */

    .whatsapp {
      position: fixed;
      right: 20px;
      bottom: 20px;
      width: 58px;
      height: 58px;
      background: var(--green);
      color: #fff;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: 28px;
      z-index: 1100;
      box-shadow: 0 8px 25px rgba(0,0,0,.25);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%,100% { box-shadow: 0 8px 25px rgba(0,0,0,.25); }
      50% { box-shadow: 0 8px 35px rgba(37,211,102,.45); }
    }

    /* ================= CART DRAWER ================= */

    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.55);
      z-index: 1200;
      opacity: 0;
      visibility: hidden;
      transition: .3s;
    }

    .overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .cart-drawer {
      position: fixed;
      right: -450px;
      top: 0;
      bottom: 0;
      width: min(430px, 92%);
      background: #fff;
      z-index: 1300;
      transition: .35s;
      display: flex;
      flex-direction: column;
    }

    .cart-drawer.active {
      right: 0;
    }

    .cart-header {
      padding: 20px;
      border-bottom: 1px solid #eee;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .cart-header h2 {
      font-family: "Playfair Display", serif;
    }

    .close-cart {
      border: 0;
      background: transparent;
      font-size: 25px;
      cursor: pointer;
    }

    .cart-items {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .empty-cart {
      text-align: center;
      color: var(--gray);
      padding: 60px 20px;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 65px 1fr auto;
      gap: 12px;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid #eee;
    }

    .cart-item img {
      width: 65px;
      height: 75px;
      border-radius: 7px;
    }

    .cart-item h4 {
      font-size: 13px;
    }

    .cart-item p {
      font-size: 12px;
      color: var(--gray);
    }

    .quantity {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
    }

    .quantity button {
      width: 24px;
      height: 24px;
      border: 1px solid #ddd;
      background: #fff;
      cursor: pointer;
    }

    .remove-item {
      color: #d33;
      background: none;
      border: 0;
      cursor: pointer;
      font-size: 12px;
    }

    .cart-footer {
      border-top: 1px solid #eee;
      padding: 20px;
    }

    .cart-total {
      display: flex;
      justify-content: space-between;
      font-weight: 800;
      font-size: 18px;
      margin-bottom: 15px;
    }

    .checkout {
      width: 100%;
    }

    /* ================= MODAL ================= */

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.65);
      z-index: 1400;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      opacity: 0;
      visibility: hidden;
      transition: .3s;
    }

    .modal.active {
      opacity: 1;
      visibility: visible;
    }

    .modal-content {
      width: min(850px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      background: #fff;
      border-radius: 18px;
      position: relative;
    }

    .modal-close {
      position: absolute;
      right: 15px;
      top: 15px;
      z-index: 2;
